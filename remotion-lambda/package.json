{
  "name": "remotion-lambda",
  "version": "1.0.0",
  "description": "Remotion compositions for AgentWeb video post-processing",
  "main": "src/index.ts",
  "scripts": {
    "build": "npx tsc",
    "deploy": "npx remotion lambda functions deploy && npx remotion lambda sites create --site-name=agentweb-compositions",
    "deploy:functions": "npx remotion lambda functions deploy",
    "deploy:site": "npx remotion lambda sites create --site-name=agentweb-compositions",
    "render:local": "npx remotion render"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.290",
    "@remotion/lambda": "4.0.290",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.3.3"
  }
}
