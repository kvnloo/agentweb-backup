# Notion test-env credentials — NEVER commit. Source of truth is AWS Secrets
# Manager (agentweb/test-env/notion-token). Cloud-dev EC2 instances write
# these files at boot from the secret (see test-env/user-data-dev-auto.sh:396).
.notion-token
.notion-page-id

