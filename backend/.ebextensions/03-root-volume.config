# Root EBS volume sizing.
#
# The AL2023 platform default is an 8 GB root volume. On a long-lived prod
# instance that redeploys often and buffers large nginx responses + logs to
# disk, 8 GB is far too little headroom — the 2026-06-26 outage was an 11-day
# instance whose 8 GB root filled to 100%. Give it real headroom on gp3.
#
# NOTE: changing the root volume size requires NEW instances — applying this
# triggers a one-time rolling instance replacement.
option_settings:
  aws:autoscaling:launchconfiguration:
    RootVolumeType: gp3
    RootVolumeSize: "40"
