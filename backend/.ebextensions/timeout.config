# AWS Elastic Beanstalk timeout configuration
#
# ENG-818 — each layer must have strictly MORE headroom than the one it wraps:
#   app 600s  <  nginx 660s  <  ALB IdleTimeout 720s  <=  DeregistrationDelay 720s
#
# These previously all sat at 600s, deliberately "matching" the nginx timeout. Matching
# exactly is the bug: with zero headroom the ALB and nginx tore the connection down at the
# same instant the application's own cap fired, so the app's structured timeout response
# never reached the caller — they got a raw HTML 504 instead. Asserted by
# src/__tests__/timeoutLayerOrdering.test.ts.
#
# Raising these does not let a request run longer. The application still gives up at 600s;
# the extra time only guarantees its answer has room to be delivered.
option_settings:
  # Load-balancer idle timeout: 12 minutes. Must exceed the nginx proxy read/send
  # timeout (660s) so the ALB never severs a connection nginx is still serving.
  aws:elbv2:loadbalancer:
    IdleTimeout: 720
  # ALB deregistration delay: 12 minutes. After an instance is deregistered the ALB holds
  # TCP connections open this long so in-flight agent-mode runs and scheduled chats can
  # finish before it exits. Must be >= IdleTimeout, or a deploy severs requests the rest
  # of the stack is still willing to serve — the same collision one layer over.
  aws:elasticbeanstalk:environment:process:default:
    DeregistrationDelay: 720
