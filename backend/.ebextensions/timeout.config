# AWS Elastic Beanstalk timeout configuration
option_settings:
  # Increase the load balancer idle timeout to 10 minutes (600 seconds)
  # This matches the Nginx timeout to allow long-running scheduled chat operations
  aws:elbv2:loadbalancer:
    IdleTimeout: 600
  # ALB deregistration delay is documented but INTENTIONALLY NOT DECLARED HERE.
  #
  # ENG-823: two straight `.ebextensions` fixes both silently failed to apply —
  # first a namespace-string guess (commit 5029dfadb, 2026-07-01), then the
  # namespace this issue's own root cause proved correct
  # (aws:elasticbeanstalk:environment:process, no `:default`; commit
  # 1becd3956, 2026-09-04). That second fix deployed clean on both
  # environments per EB's own event log, and STILL left both target groups'
  # live `deregistration_delay.timeout_seconds` at 20 (verified via
  # `aws elbv2 describe-target-group-attributes`, the only ground truth this
  # issue accepts — not the EB config view, which reports the override as
  # absent even though the deploy that declared it succeeded).
  #
  # AC4's fallback: stop declaring a value here that a config-only or
  # .ebextensions-based EB apply has now failed to register twice under two
  # different plausible namespaces. The real mechanism is
  # `aws elbv2 modify-target-group-attributes`, applied directly against the
  # live target group as the last step of every backend deploy — see
  # `ensure_deregistration_delay()` in `.github/scripts/eb-deploy.sh`, which
  # runs after `verify_deployment` succeeds and re-asserts the value on every
  # deploy so a manual/console change can't silently drift it back to the
  # AWS default. Search history for "DeregistrationDelay" before touching
  # this file again.
