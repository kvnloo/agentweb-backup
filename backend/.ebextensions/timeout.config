# AWS Elastic Beanstalk timeout configuration
option_settings:
  # ALB idle timeout: 720s (12 min) — the OUTERMOST timeout layer (ENG-818).
  #
  # This must stay strictly greater than nginx's proxy_read_timeout, which in
  # turn must exceed the app's AGENT_MODE_GENERATION_TIMEOUT_MS:
  #
  #     app 600s  <  nginx 660s  <  ALB 720s
  #
  # All three previously sat at exactly 600s. With zero headroom the app always
  # lost the race: at T=600s its `withGenerationTimeout` fired, but nginx and the
  # ALB hit their own deadline at the same instant and tore the connection down
  # before the app could reject the promise, run the continuation logic, persist
  # a message and serialize a body. Callers got nginx's raw HTML 504 instead of
  # the structured JSON response — so a programmatic caller also got a JSON parse
  # error on top of the timeout.
  #
  # That is why the same bug class has been closed five times (ENG-190, ENG-287,
  # ENG-317, ENG-472, ENG-510) and stayed live: every one of those fixes repaired
  # the application path, which the infrastructure was preempting.
  #
  # ORDERING IS LOAD-BEARING: raise this OUTER value before lowering/raising the
  # inner ones, never the reverse, or there is a window where nginx outlives the
  # ALB. This PR is deliberately resource-config ONLY — the matching nginx change
  # ships separately, because production deploys immutable and AWS refuses a
  # combined resource+instance update. Landing both at once is what stranded
  # main for ~29 hours on 2026-08-01 (ENG-836).
  aws:elbv2:loadbalancer:
    IdleTimeout: 720
  # ALB deregistration delay: 10 minutes.
  # After the old instance is deregistered, the ALB holds TCP connections open
  # this long so in-flight scheduled chats can complete before the instance exits.
  aws:elasticbeanstalk:environment:process:default:
    DeregistrationDelay: 600
