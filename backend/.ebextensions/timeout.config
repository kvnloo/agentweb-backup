# AWS Elastic Beanstalk timeout configuration
option_settings:
  # Increase the load balancer idle timeout to 10 minutes (600 seconds)
  # This matches the Nginx timeout to allow long-running scheduled chat operations
  aws:elbv2:loadbalancer:
    IdleTimeout: 600
  # ALB deregistration delay: 10 minutes.
  # After the old instance is deregistered, the ALB holds TCP connections open
  # this long so in-flight scheduled chats can complete before the instance exits.
  #
  # ENG-823: this namespace previously had a trailing `:default`
  # (`aws:elasticbeanstalk:environment:process:default`), which does not exist
  # in this environment's option catalog — verified via
  # `aws elasticbeanstalk describe-configuration-options` against the live
  # `Agentweb-backend-env-prod-3` environment, which lists `DeregistrationDelay`
  # only under `aws:elasticbeanstalk:environment:process` (no `:default`).
  # EB silently drops an option in an unrecognised namespace instead of
  # rejecting the deploy, so this value has never actually applied: prod's
  # live ALB target group reads `deregistration_delay.timeout_seconds = 20`
  # (the AWS default), confirmed via `aws elbv2 describe-target-group-attributes`
  # — not the EB config view, which is what let this survive undetected.
  aws:elasticbeanstalk:environment:process:
    DeregistrationDelay: 600
