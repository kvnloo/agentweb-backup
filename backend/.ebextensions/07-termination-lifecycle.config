# ENG-764: don't let a deploy kill an in-flight scheduled run.
#
# Prod evidence (2026-07-29, Agentweb-backend-env-prod-3): an immutable deploy
# added the new instance at 10:17:06 and removed the old one at 10:22:06 — 3m19s
# later. A scheduled run that started on the old instance at 10:17:03 and needed
# ~5.4 min was killed mid-flight, then requeued by the reconciler ~20 min later.
#
# The app already drains for 10 min on shutdown (DRAIN_CEILING_MS) and the ALB
# DeregistrationDelay is 600s, but NEITHER makes the Auto Scaling group wait — it
# terminates on its own schedule, so the drain never gets its window. A termination
# lifecycle hook is the piece that actually holds the instance: it parks in
# `Terminating:Wait` until something answers, and src/services/asgLifecycleGuard.ts
# answers CONTINUE as soon as the drain finishes.
#
# Failure modes are all bounded:
#  - App can't answer (missing grant, crash, force-exit): the hook expires after
#    HeartbeatTimeout and DefaultResult=CONTINUE terminates it anyway. Never stuck.
#  - HeartbeatTimeout (900s) is deliberately ABOVE the app's own force-exit backstop
#    (DRAIN_CEILING_MS 600s + 3 min = 780s), so the app always gets to finish and
#    answer first; the timeout is the fallback, not the normal path.
#  - This also protects the weekly managed instance refresh (05-instance-recycling),
#    not just deploys — a recycle must not kill a run either.
Resources:
  AgentWebTerminationLifecycleHook:
    Type: AWS::AutoScaling::LifecycleHook
    Properties:
      AutoScalingGroupName:
        Ref: AWSEBAutoScalingGroup
      # Pinned name so the instance can answer its own hook without needing
      # autoscaling:DescribeLifecycleHooks. Mirrored in asgLifecycleGuard.ts as
      # TERMINATION_LIFECYCLE_HOOK_NAME — keep the two in sync.
      LifecycleHookName: agentweb-drain-before-terminate
      LifecycleTransition: autoscaling:EC2_INSTANCE_TERMINATING
      HeartbeatTimeout: 900
      DefaultResult: CONTINUE

  # Least-privilege grant so the instance can release itself once drained.
  # CompleteLifecycleAction/RecordLifecycleActionHeartbeat are scoped to THIS
  # environment's ASG; only the Describe call needs "*" (it has no resource-level
  # permissions). Fn::Join rather than Fn::Sub — the more conservative intrinsic
  # for .ebextensions. The policy name is stack-scoped so the staging and prod
  # stacks can both attach to the shared aws-elasticbeanstalk-ec2-role without
  # overwriting each other.
  AgentWebTerminationLifecyclePolicy:
    Type: AWS::IAM::Policy
    Properties:
      PolicyName:
        Fn::Join:
          - '-'
          - - Ref: 'AWS::StackName'
            - 'drain-lifecycle'
      Roles:
        - aws-elasticbeanstalk-ec2-role
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Action:
              - autoscaling:CompleteLifecycleAction
              - autoscaling:RecordLifecycleActionHeartbeat
            Resource:
              Fn::Join:
                - ''
                - - 'arn:aws:autoscaling:'
                  - Ref: 'AWS::Region'
                  - ':'
                  - Ref: 'AWS::AccountId'
                  - ':autoScalingGroup:*:autoScalingGroupName/'
                  - Ref: AWSEBAutoScalingGroup
          - Effect: Allow
            Action:
              - autoscaling:DescribeAutoScalingInstances
            Resource: '*'
