# Disk-utilization telemetry + alarm.
#
# Enhanced health is enabled but publishes NO CloudWatch metrics today, so the
# 2026-06-26 disk fill was invisible until users hit "Failed to load users".
# (1) Publish the per-instance RootFilesystemUtil metric (60s granularity),
#     preserving the env's existing health rules.
# (2) Alarm at >=80% root-disk utilization -> agentweb-oncall-alerts SNS, so we
#     get paged days before the disk hits 100% again.
#
# The alarm dimension uses AWSEBEnvironmentName so it is correct in every env
# (prod + staging) without hardcoding a name.
option_settings:
  aws:elasticbeanstalk:healthreporting:system:
    ConfigDocument: |
      {
        "Version": 1,
        "CloudWatchMetrics": {
          "Instance": { "RootFilesystemUtil": 60 },
          "Environment": {}
        },
        "Rules": {
          "Environment": {
            "ELB": { "ELBRequests4xx": { "Enabled": true } },
            "Application": { "ApplicationRequests4xx": { "Enabled": true } }
          }
        }
      }

Resources:
  RootFilesystemHighAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmDescription: "Root filesystem >= 80% on an instance in this Elastic Beanstalk environment"
      Namespace: AWS/ElasticBeanstalk
      MetricName: RootFilesystemUtil
      Dimensions:
        - Name: EnvironmentName
          Value: { "Ref": "AWSEBEnvironmentName" }
      Statistic: Maximum
      Period: 300
      EvaluationPeriods: 2
      Threshold: 80
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions:
        - "arn:aws:sns:us-west-2:992382574572:agentweb-oncall-alerts"
      OKActions:
        - "arn:aws:sns:us-west-2:992382574572:agentweb-oncall-alerts"
