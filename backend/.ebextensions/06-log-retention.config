# Log retention caps — belt-and-suspenders so no single chatty code path can
# ever fill the root disk again (the app fix in devEnvService removes the source;
# these bound the blast radius regardless).
#
# (1) Stream EB logs to CloudWatch (14-day retention) so disk is not the only
#     log buffer.
# (2) Cap /var/log/messages via logrotate (size-based) — it had ballooned to
#     424 MB between weekly rotations during the incident.
# (3) Cap the systemd journal so its mirror of stdout can't grow unbounded.
option_settings:
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 14

files:
  "/etc/logrotate.d/agentweb-messages":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/messages {
        su root root
        size 50M
        rotate 3
        compress
        missingok
        notifempty
        copytruncate
      }

  "/etc/systemd/journald.conf.d/10-agentweb-cap.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Journal]
      SystemMaxUse=200M
      MaxRetentionSec=7day

container_commands:
  01-reload-journald:
    command: "systemctl restart systemd-journald || true"
