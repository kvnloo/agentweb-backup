# ENG-2070: Enigma card-revenue enrichment, internal test account only.
#
# Why this file instead of EB console env properties: the EB console/API
# config-update path fails at the Immutable-stack CloudFormation staging step
# for non-CI identities, so the two variables are shipped with the bundle and
# applied by the CI deploy identity, which deploys this environment daily.
#
# Scope: ENIGMA_ENRICHMENT_ENABLED=true AND user on the allowlist. The
# allowlist holds exactly one internal admin account (Anurag). Enigma's terms
# are internal-use only; customer enablement is ENG-1930 and stays off.
#
# Rollback: set ENIGMA_ENRICHMENT_ENABLED to "false" here (or delete this
# file) and deploy. Lookups stop at once; stored values stay.
option_settings:
  aws:elasticbeanstalk:application:environment:
    ENIGMA_ENRICHMENT_ENABLED: "true"
    ENIGMA_ENRICHMENT_USER_ALLOWLIST: 58ad8518-d33f-4347-a024-59a3f0ab216b
