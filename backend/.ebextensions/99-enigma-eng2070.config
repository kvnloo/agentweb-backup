# ENG-2070: Enigma card revenue for internal AgentWeb/Argusoft team members.
#
# Decision (ENG-1930, 2026-09-24): staying on Enigma's Pro plan, internal use
# only, permanently. Their terms don't allow showing this to our customers or
# reusing a value across customer accounts. This allowlist may name any number
# of our own team members — that's still "internal business purposes" — but
# must NEVER include a real customer account. The portal display code
# (customer-portal PR #1169) has no independent check against that; this
# allowlist is the only thing enforcing it.
#
# OPENROUTER_GATEWAY_TASK_CLASSES, DISCORD_INVITE_URL and GCS_BUCKET used to be
# emptied here to keep the env-var payload under CloudFormation's 4,096-char
# EnvironmentVariables limit. Nothing in the backend reads them, so they are no
# longer set at all; the empty names were still costing 65 chars of that limit.
#
# Rollback: set ENIGMA_ENRICHMENT_ENABLED to "false" and deploy.
option_settings:
  aws:elasticbeanstalk:application:environment:
    ENIGMA_ENRICHMENT_ENABLED: "true"
    # All 8 accounts with isAdmin=true as of 2026-09-24 (verified directly
    # against AW-Users), in no particular order:
    #   ftan@agentweb.pro, aseth@argusoft.com, harsha@agentweb.pro,
    #   hshah@argusoft.com, ruiw@agentweb.pro, rui.storywithai@gmail.com,
    #   matthew@agentweb.pro, mvarma@argusoft.com
    ENIGMA_ENRICHMENT_USER_ALLOWLIST: b7c829c6-3df7-4c1e-b37a-78d811d92294,58ad8518-d33f-4347-a024-59a3f0ab216b,1743956381327,9316560e-15ff-45c5-b0fd-04f5fac212ee,1746747115266,1737989496248,1740518469115,1d2547e7-b5b8-4f89-8dd1-740e0a07b8f5
