# ENG-2070: Enigma card-revenue enrichment, internal test account only.
#
# Why this file instead of EB console env properties: the EB console/API
# config-update path fails at the Immutable-stack CloudFormation staging step
# with an S3 Access Denied error, for every identity tried so far, on both add
# and remove requests (confirmed on ENG-2071). The two Enigma variables are
# shipped with the deploy bundle instead, applied by the CI deploy identity,
# which deploys this environment successfully many times a day.
#
# Why the three vars below are blanked, not just added: this same route is
# the only way to shrink the payload too. The environment's existing 67
# variables already total ~4,057 chars against CloudFormation's 4,096-char
# EnvironmentVariables parameter limit (a second, independent wall from the
# staging error above — confirmed by testing an --options-to-remove call,
# which hit the identical staging error even though it only shrinks the
# payload). Adding the two Enigma vars without freeing room first fails
# deploys outright (this happened once already: PR #3013, reverted in #3016).
#
# OPENROUTER_GATEWAY_TASK_CLASSES, DISCORD_INVITE_URL and GCS_BUCKET have zero
# references anywhere in this repo (verified with a full-tree grep, not just
# backend/src) so are blanked here rather than left to burn ~199 chars of
# headroom. This only clears their VALUE — .ebextensions can override an
# existing option but not delete one outright, so the names remain (~62
# chars). A real deletion via `update-environment --options-to-remove` can
# reclaim that once the ENG-2071 staging-error identity/permission issue is
# fixed; not blocking on that here.
#
# Scope: ENIGMA_ENRICHMENT_ENABLED=true AND user on the allowlist. The
# allowlist holds exactly one internal admin account (Anurag). Enigma's terms
# are internal-use only; customer enablement is ENG-1930 and stays off.
#
# Rollback: set ENIGMA_ENRICHMENT_ENABLED to "false" here (or delete this
# file) and deploy. Lookups stop at once; stored values stay. The three
# blanked variables are unused either way, so leaving them blank is safe
# even on rollback.
option_settings:
  aws:elasticbeanstalk:application:environment:
    ENIGMA_ENRICHMENT_ENABLED: "true"
    ENIGMA_ENRICHMENT_USER_ALLOWLIST: 58ad8518-d33f-4347-a024-59a3f0ab216b
    OPENROUTER_GATEWAY_TASK_CLASSES: ""
    DISCORD_INVITE_URL: ""
    GCS_BUCKET: ""
