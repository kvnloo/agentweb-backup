# ENG-2070: Enigma card revenue for one internal test user only.
# The env-var payload is at CloudFormation's 4096-char EnvironmentVariables
# limit, so three unreferenced vars are emptied here to make room
# (whole-repo grep: zero backend refs). .ebextensions cannot delete
# console-set vars, only override them.
# Rollback: set ENIGMA_ENRICHMENT_ENABLED to "false" and deploy.
option_settings:
  aws:elasticbeanstalk:application:environment:
    OPENROUTER_GATEWAY_TASK_CLASSES: ""
    DISCORD_INVITE_URL: ""
    GCS_BUCKET: ""
    ENIGMA_ENRICHMENT_ENABLED: "true"
    ENIGMA_ENRICHMENT_USER_ALLOWLIST: 58ad8518-d33f-4347-a024-59a3f0ab216b
