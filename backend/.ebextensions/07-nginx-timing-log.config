# Ship /var/log/nginx/access_timing.log (see .platform/nginx/conf.d/
# access_log_timing.conf) to CloudWatch Logs for the per-route p99 latency
# alarm. Appends to EB's own CloudWatch agent config; does not replace it.
files:
  "/opt/aws/amazon-cloudwatch-agent/etc/agentweb-nginx-timing.json":
    mode: "000644"
    owner: root
    group: root
    content: |
      {"logs":{"logs_collected":{"files":{"collect_list":[{
        "file_path":"/var/log/nginx/access_timing.log",
        "log_group_name":"`{"Fn::Join":["",["/aws/elasticbeanstalk/",{"Ref":"AWSEBEnvironmentName"},"/var/log/nginx/access_timing.log"]]}`",
        "log_stream_name":"{instance_id}"}]}}}}

container_commands:
  01-cwagent-append-nginx-timing:
    command: "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a append-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/agentweb-nginx-timing.json -s || true"
