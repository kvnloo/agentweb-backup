files:
  "/etc/yum.repos.d/google-chrome.repo":
    mode: "000644"
    owner: root
    group: root
    content: "[google-chrome]\nname=google-chrome\nbaseurl=https://dl.google.com/linux/chrome/rpm/stable/x86_64\nenabled=1\ngpgcheck=1\ngpgkey=https://dl.google.com/linux/linux_signing_key.pub\n"

commands:
  01_install_chrome:
    command: "dnf install -y google-chrome-stable || dnf install -y chromium-headless || true"
    ignoreErrors: true
