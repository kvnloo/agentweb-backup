PORT=3001
JWT_SECRET=your-secret-key-here

# Test Account Credentials
TEST_EMAIL=test@example.com
TEST_PASSWORD=Test123!

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-west-2 

# llm model configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenRouter unified LLM gateway (ENG-9). Falls back to Secrets Manager
# ({env}/AgentWeb/OpenRouter) when unset.
OPENROUTER_API_KEY=your_openrouter_api_key_here

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Web search tools. Default/foundation tools call You.com directly; no provider fallback is hidden.
YOU_API_KEY=your_you_api_key_here
# Optional explicit google_search_web tool credentials. Not used as a fallback.
# GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
# GOOGLE_SEARCH_ENGINE_ID=your_google_custom_search_engine_id
# Optional retry controls for the search_web wrapper.
# SEARCH_WEB_MAX_RETRIES=4
# SEARCH_WEB_RETRY_BASE_MS=600

# CRM enrichment model overrides (optional — defaults to gpt-5-chat-2)
# CRM_ENRICH_V3_ALIAS_MODEL=gpt-5-chat-2
# CRM_ENRICH_V3_CLASSIFY_MODEL=gpt-5-chat-2

# URL Configuration
FRONTEND_URL=http://localhost:5173
CUSTOMER_FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:3001
LANDING_SITE_URL=https://www.agentweb.pro

MCP_ACCESS_TOKEN="your-secure-token-here"

# V0 Platform API (for landing page generation)
V0_API_KEY=your_v0_api_key_here

# SmartLead (outbound email campaigns)
SMARTLEAD_API_KEY=your_smartlead_api_key_here

# Stripe Connect OAuth (customer-owned Stripe accounts for CRM enrichment)
# Client IDs come from https://dashboard.stripe.com/settings/connect/onboarding-options
STRIPE_CONNECT_CLIENT_ID_LIVE=ca_your_live_client_id
STRIPE_CONNECT_CLIENT_ID_TEST=ca_your_test_client_id
# Webhook signing secret for Connect webhooks (separate from the platform webhook secret).
# STRIPE_CONNECT_WEBHOOK_SECRET      — test-mode Connect webhook endpoint signing secret
# STRIPE_CONNECT_WEBHOOK_SECRET_LIVE — live-mode Connect webhook endpoint signing secret
# The webhook handler picks based on STRIPE_CONNECT_MODE. To dogfood real live-mode
# events on the test env, create a LIVE webhook destination in the Stripe dashboard
# pointing at the test env's public URL and set STRIPE_CONNECT_WEBHOOK_SECRET_LIVE.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET_LIVE=whsec_your_live_connect_webhook_secret
# STRIPE_CONNECT_MODE toggles which Connect client_id + webhook secret are used: "live" or "test".
# Stripe enforces strict isolation: ca_test_xxx can only authorize TEST Stripe accounts,
# ca_live_xxx can only authorize LIVE accounts. A live client_id is required to read
# real production customer data.
# Defaults: "live" in production, "live" on the test env (so Harsha's dogfood flow can
# read real AgentWeb Stripe data — still written to Dev-* tables via TABLE_PREFIX, no
# cross-contamination), "test" for local dev.
STRIPE_CONNECT_MODE=test
# Key used to encrypt Stripe Connect access/refresh tokens at rest (32-byte hex or any string; derived via pbkdf2)
# Falls back to JWT_SECRET if unset — set explicitly for prod
CONNECT_TOKEN_ENCRYPTION_KEY=change_me_in_prod

# Onboarding Loop (self-improving A/B copy optimizer)
# Set to 'true' to enable the daily cron and hourly watchdog.
ONBOARDING_LOOP_ENABLED=false
# Harsha's Slack user ID — receives the daily review DM and watchdog escalations.
ONBOARDING_LOOP_APPROVER_SLACK_USER_ID=U0123456789
# Comma-separated step names allowed to mutate (leave empty to allow all steps).
ONBOARDING_LOOP_ALLOWLIST=

# Agent Tool Gateway
# Set to 'true' to enforce gateway policy in production (blocks unapproved tool calls).
AGENT_TOOL_GATEWAY_ENFORCE=false
# Slack user ID allowed to trigger loop approval dispatch via ✅ reaction.
# Required in production — the handler silently ignores all reactions if unset.
LOOP_APPROVAL_SLACK_USER_ID=U08TM4QFQ1L

# LinkedIn connection-accepted side effects (kill-switches).
# Both default to OFF (muted) after the 2026-06-03 notification flood — see
# docs/postmortem-2026-06-03-linkedin-connection-notification-flood.md.
# Set to 'true' ONLY when the de-dupe/sender-gate/backfill safeguards are verified.
# LINKEDIN_CONNECTION_NOTIFY: owner email/Slack alerts ("X accepted your invite").
LINKEDIN_CONNECTION_NOTIFY=false
# LINKEDIN_CONNECTION_ENROLL: auto-enroll accepted leads into drip sequences
# (this is what triggers OUTBOUND messages to leads).
LINKEDIN_CONNECTION_ENROLL=false
