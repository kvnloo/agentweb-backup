PORT=3001
# Secret used to sign/verify JWTs and derive encryption keys for stored credentials.
# Required — the server refuses to boot without it. Generate with: openssl rand -hex 32
JWT_SECRET=

# Shared secret for POST /api/agent-mode/run-scheduled-chats (ENG-347).
# Must match SCHEDULED_CHATS_SERVICE_SECRET on the agent-engine (sent as the
# x-service-secret header). Optional: when unset, the endpoint accepts
# unauthenticated requests (pre-rollout mode) and logs a warning. Set it on
# the agent-engine first, then here. Generate with: openssl rand -hex 32
# SCHEDULED_CHATS_SERVICE_SECRET=

# Test Account Credentials
TEST_EMAIL=test@example.com
TEST_PASSWORD=Test123!

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-west-2 

# llm model configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ENG-9: falls back to Secrets Manager {env}/AgentWeb/OpenRouter if unset (see getOpenRouterClient)
OPENROUTER_API_KEY=your_openrouter_api_key_here

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# H-JEV: typed semantic decisions for Emma (RFC H-JEV, default off = fail-open skip)
# JEV_BACKEND=off|typesafe|openjev
# JEV_TIMEOUT_MS=2500
# JEV_MODEL=jev-latest
# TYPESAFE_API_KEY=           # required when JEV_BACKEND=typesafe
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# OPENJEV_BASE_URL=           # required when JEV_BACKEND=openjev (System One-compatible HTTP)
# OPENJEV_API_KEY=            # optional bearer token for self-hosted OpenJev gateway
# JEV_REPORT_CLASSIFY=off|shadow  # Phase-1 shadow: log Jev vs incumbent report-type comparison, never alter result

# Web search tools. Default/foundation tools call You.com directly; no provider fallback is hidden.
YOU_API_KEY=your_you_api_key_here
# Optional explicit google_search_web tool credentials. Not used as a fallback.
# GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
# GOOGLE_SEARCH_ENGINE_ID=your_google_custom_search_engine_id
# Optional retry controls for the search_web wrapper.
# SEARCH_WEB_MAX_RETRIES=4
# SEARCH_WEB_RETRY_BASE_MS=600

# CRM enrichment model overrides (optional — unset uses the org's enrichment model, else the role default gpt-5.6-luna)
# Rollback for the enrichment default (orgs with their own override are unaffected). Takes effect on restart.
# CRM_ENRICH_V3_DEFAULT_MODEL=gpt-5.5
# Web-search tool parameters for enrichment (JSON). Unset = OpenRouter defaults (no cap on searches).
# Note: max_uses is only honoured by Anthropic's native search; with OpenAI models it needs engine exa or
# parallel, and changing the engine changes retrieval quality and price. max_results is at most 25.
# A non-default engine (exa, firecrawl, parallel...) sends the search text (lead names, companies) to that
# provider, so treat switching it as a data-sharing decision, not just a cost one.
# CRM_ENRICH_V3_WEB_SEARCH_PARAMS={"engine":"parallel"}
# Per-call overrides. Setting one pins that call to the given model for every org; leave unset to follow the enrichment role.
# ALIAS: field alias inference at config save. CLASSIFY: smart-field classification (falls back to ALIAS).
# EXTRACT: the sibling field mapping at run start, and also the extraction web-search model and the budget estimate.
# CRM_ENRICH_V3_ALIAS_MODEL=<model id>
# CRM_ENRICH_V3_CLASSIFY_MODEL=<model id>
# CRM_ENRICH_V3_EXTRACT_MODEL=<model id>

# URL Configuration
FRONTEND_URL=http://localhost:5173
CUSTOMER_FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:3001
LANDING_SITE_URL=https://www.agentweb.pro

MCP_ACCESS_TOKEN="your-secure-token-here"

# V0 Platform API (for landing page generation)
V0_API_KEY=your_v0_api_key_here

# ENG-2327: automatic organic + paid session tracking for NEW landing pages. Default OFF (unset).
# true or 1 = after a page deploys, generation creates its "LP Sessions - <name>" list and commits the
# AgentWeb SDK tag into the page's repo (one extra commit / Vercel build). Failures never fail generation.
# Requires BACKEND_URL to be this API's public https origin (the tag loads <BACKEND_URL>/sdk/v1/aw.js).
# AUTO_SESSION_TRACKING=true

# SmartLead (outbound email campaigns)
SMARTLEAD_API_KEY=your_smartlead_api_key_here

# Stripe Connect OAuth (customer-owned Stripe accounts for CRM enrichment)
# Client IDs come from https://dashboard.stripe.com/settings/connect/onboarding-options
STRIPE_CONNECT_CLIENT_ID_LIVE=ca_your_live_client_id
STRIPE_CONNECT_CLIENT_ID_TEST=ca_your_test_client_id
# Webhook signing secret for Connect webhooks (separate from the platform webhook secret).
# STRIPE_CONNECT_WEBHOOK_SECRET      — test-mode Connect webhook endpoint signing secret
# STRIPE_CONNECT_WEBHOOK_SECRET_LIVE — live-mode Connect webhook endpoint signing secret
# The webhook handler picks based on STRIPE_CONNECT_MODE. To dogfood real live-mode
# events on the test env, create a LIVE webhook destination in the Stripe dashboard
# pointing at the test env's public URL and set STRIPE_CONNECT_WEBHOOK_SECRET_LIVE.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET_LIVE=whsec_your_live_connect_webhook_secret
# STRIPE_CONNECT_MODE toggles which Connect client_id + webhook secret are used: "live" or "test".
# Stripe enforces strict isolation: ca_test_xxx can only authorize TEST Stripe accounts,
# ca_live_xxx can only authorize LIVE accounts. A live client_id is required to read
# real production customer data.
# Defaults: "live" in production, "live" on the test env (so Harsha's dogfood flow can
# read real AgentWeb Stripe data — still written to Dev-* tables via TABLE_PREFIX, no
# cross-contamination), "test" for local dev.
STRIPE_CONNECT_MODE=test
# Key used to encrypt Stripe Connect access/refresh tokens at rest (32-byte hex or any string; derived via pbkdf2)
# Falls back to JWT_SECRET if unset — set explicitly for prod
CONNECT_TOKEN_ENCRYPTION_KEY=change_me_in_prod

# Seat-based billing (ENG-2243..2246): the Stripe Product ID for the durable
# "Extra Seat" product. orgSeatBillingService uses inline price_data on the
# subscription item (not a stored Stripe Price), identifying the seat line
# item live by matching its price's product against this ID. Creating the
# Product itself is a manual, one-time ops step outside this app.
STRIPE_EXTRA_SEAT_PRODUCT_ID=prod_your_extra_seat_product_id

# Onboarding Loop (self-improving A/B copy optimizer)
# Set to 'true' to enable the daily cron and hourly watchdog.
ONBOARDING_LOOP_ENABLED=false
# Harsha's Slack user ID — receives the daily review DM and watchdog escalations.
ONBOARDING_LOOP_APPROVER_SLACK_USER_ID=U0123456789
# Comma-separated step names allowed to mutate (leave empty to allow all steps).
ONBOARDING_LOOP_ALLOWLIST=

# Agent Tool Gateway
# Set to 'true' to enforce gateway policy in production (blocks unapproved tool calls).
AGENT_TOOL_GATEWAY_ENFORCE=false
# Slack user ID allowed to trigger loop approval dispatch via ✅ reaction.
# Required in production — the handler silently ignores all reactions if unset.
LOOP_APPROVAL_SLACK_USER_ID=U08TM4QFQ1L

# Comma-separated Slack Connect team IDs trusted to run the "@Emma for user <email> link this
# channel" command even when their profile email fails to resolve (ENG-1294) — a genuine Slack
# Connect guest can never match our own workspace's team_id, by definition, so this is the only
# signal that can authorize them. Defaults to Argusoft's team (confirmed 2026-09-03).
AGENTWEB_TRUSTED_EXTERNAL_SLACK_TEAM_IDS=T093CUE1WGP

# LinkedIn connection-accepted side effects (kill-switches).
# Both default to OFF (muted) after the 2026-06-03 notification flood — see
# docs/postmortem-2026-06-03-linkedin-connection-notification-flood.md.
# Set to 'true' ONLY when the de-dupe/sender-gate/backfill safeguards are verified.
# LINKEDIN_CONNECTION_NOTIFY: owner email/Slack alerts ("X accepted your invite").
LINKEDIN_CONNECTION_NOTIFY=false
# LINKEDIN_CONNECTION_ENROLL: auto-enroll accepted leads into drip sequences
# (this is what triggers OUTBOUND messages to leads).
LINKEDIN_CONNECTION_ENROLL=false

# Fathom → Linear task router (ENG-259). Governs the /api/webhooks/fathom
# reconciliation leg: off = acknowledge only (rollback lever), shadow = compute
# and log every create/enrich/relate/no-op decision against real board reads
# but write NOTHING (default; PRD Phase-1 posture), live = write to Linear.
# The flip to "live" is gated on human shadow-mode acceptance (ENG-447), and
# routing stays inactive until the production LinearPort adapter (ENG-536)
# registers at startup. Linear credentials come from AWS Secrets Manager
# ({env}/AgentWeb/Linear), never from env.
FATHOM_LINEAR_ROUTER_MODE=shadow

# Shared secret authenticating Fathom webhook deliveries (ENG-259 / PR #2203).
# Include it in the registered webhook destination URL (…/api/webhooks/fathom?token=<secret>)
# or send it as the x-fathom-webhook-token header. When set, requests without it are
# rejected 401. The router leg REFUSES to run while a LinearPort adapter is registered
# and this is unset — Linear is never read or written on an unauthenticated surface.
FATHOM_WEBHOOK_SECRET=

# Shared secret Unipile echoes back verbatim (as the `Unipile-Auth` header) on every
# account_status webhook delivery (ENG-1197) — set at registration time via
# scripts/register-unipile-account-status-webhook.ts. Unlike FATHOM_WEBHOOK_SECRET,
# this endpoint FAILS CLOSED when unset — every request is rejected, never accepted
# unauthenticated.
UNIPILE_WEBHOOK_SECRET=

# ENG-1557 v1: lets an admin MCP call actually create a lead in a specific
# customer's list on the customer's behalf (manage_leads action "add" +
# client_id), using the same delegate-access token mechanism as the
# customer-portal "delegate access" UI. Default OFF (fail-safe) — the write
# path is disabled until Harsha reviews the full contract (admin-only gate,
# audit trail, dry-run preview) and flips this. dry_run:true works regardless
# of this flag — it never mutates, so it's safe to exercise before the flip.
# "list"/"get"/"add" client_id scoping in dry_run mode is unaffected either way.
MANAGE_LEADS_CROSS_ACCOUNT_ADD_ENABLED=false

# H-LEARN: append-only reliability telemetry at tool boundary (default memory; off = disabled)
# RELIABILITY_EVENT_SINK=memory|off
