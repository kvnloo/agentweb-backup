# ENG-2110: everything the production worker pins. Sourced by install.sh and copied into the tarball's MANIFEST.
# Changing a value here changes what runs on a machine that holds customers' Claude logins: review it like code.

# Node 22: official tarball. TARBALL_SHA256 is the line for node-v22.23.3-linux-x64.tar.xz in https://nodejs.org/dist/v22.23.3/SHASUMS256.txt
# (fetched over https 2026-10-21); BIN_SHA256 is the sha256 of bin/node inside it (the same binary the test instance runs).
NODE_VERSION=22.23.3
NODE_TARBALL_URL=https://nodejs.org/dist/v22.23.3/node-v22.23.3-linux-x64.tar.xz
NODE_TARBALL_SHA256=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
NODE_BIN_SHA256=fde6a4bf8d0562f7751d1a2d6cb9b417c4cfe107bbcb0aa3e9a24e125e348f48

# Claude Code: the native x86-64 binary shipped in the npm package @anthropic-ai/claude-code-linux-x64 (the same package the backend pins in
# package-lock.json). TARBALL_INTEGRITY is the npm SRI (sha512) from package-lock.json AND the registry's dist.integrity (they were checked
# equal on 2026-10-21); BIN_SHA256 is the sha256 of `package/claude` inside it, which equals the binary the test instance has run since 2026-10-20.
CLAUDE_VERSION=2.1.294
CLAUDE_TARBALL_URL=https://registry.npmjs.org/@anthropic-ai/claude-code-linux-x64/-/claude-code-linux-x64-2.1.294.tgz
CLAUDE_TARBALL_INTEGRITY=sha512-PGRIYkEyXxDMcosvkidWA815Y3dnEmZUrTdydabU7OPsh0Cbxnj+ej87sHFmaWOLzlpQTmi2AMUsdEHfsh3Adg==
CLAUDE_BIN_SHA256=27122ca7b624f537546fbef35b80c66370d974ff258f3d9b10ac50bb8771f262

# This worker (a fixed private IP, see ENG-2114): the TLS server certificate must name it.
WORKER_PRIVATE_IP=172.31.30.50
TLS_SECRET_SERVER=prod/AgentWeb/LoginHost/server
TLS_SECRET_CA=prod/AgentWeb/LoginHost/ca
AWS_REGION=us-west-2
