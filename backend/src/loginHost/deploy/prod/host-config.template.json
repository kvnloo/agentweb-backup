{
  "env": "prod",
  "uidMin": 500000,
  "uidMax": 510000,
  "socket": { "dir": "/run/aw-login-host-prod", "gid": 10, "mode": 384 },
  "limits": { "memoryMax": "1G", "tasksMax": 256, "tmpSize": "128M", "shmSize": "64M", "runtimeMaxSec": 1800 },
  "quota": { "blocksKb": 204800, "inodes": 20000 },
  "manager": { "maxTurnsPerHost": 8 },
  "tls": {
    "host": "172.31.30.50",
    "port": 8443,
    "certPath": "/etc/aw-login-host/tls/server.crt",
    "keyPath": "/etc/aw-login-host/tls/server.key",
    "caPath": "/etc/aw-login-host/tls/ca.crt",
    "clientCommonNames": ["agentweb-backend-prod"]
  },
  "egress": {
    "allow": ["api.anthropic.com:443", "platform.claude.com:443", "console.anthropic.com:443", "claude.ai:443"]
  },
  "claude": {
    "binaryPath": "/opt/aw-claude/2.1.294/claude",
    "expectedSha256": "@@CLAUDE_BIN_SHA256@@",
    "version": "2.1.294",
    "systemPromptFile": "/opt/aw-login-host/system-prompt.txt",
    "bridgeUrl": "@@BRIDGE_URL@@"
  }
}
