# Copy to .linear-autofix/.env (gitignored) and fill in.
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx
# Set to 1 ONLY on the designated runner (the EC2 box). Real fixes refuse to run without it;
# dry-runs work anywhere. Keeps laptops from burning quota / posting to Linear by accident.
AUTOFIX_RUN_ENABLED=0
# MCP credentials referenced by .mcp.json via ${VAR} (kept out of the tracked config).
# Notion: the FULL header JSON as one value (single-quoted so the braces/quotes survive sourcing).
NOTION_MCP_HEADERS='{"Authorization":"Bearer <YOUR_NOTION_TOKEN>","Notion-Version":"2025-09-03"}'
OKAREO_API_KEY=<YOUR_OKAREO_API_KEY>
