# Copy to .linear-autofix/.env (gitignored) and fill in.
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx
# Set to 1 ONLY on the designated runner (the EC2 box). Real fixes refuse to run without it;
# dry-runs work anywhere. Keeps laptops from burning quota / posting to Linear by accident.
AUTOFIX_RUN_ENABLED=0

# Shared secret for the preview access gate (ENG-920). The preview ports (5173/5174/3001) are
# internet-exposed on the runner and the app behind them holds live dev AWS credentials, so
# preview/proxy.mjs refuses every off-box request that doesn't present this. Reviewers open a
# preview URL ONCE with `?k=<token>`; the proxy sets a 30-day HttpOnly cookie and redirects.
# On-box traffic (loopback/private ranges + this instance's own IP) never needs it, so the
# Playwright verify step is unaffected. If this is UNSET the proxy fails CLOSED — previews keep
# working on the box, but nobody off-box gets in. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PREVIEW_ACCESS_TOKEN=

# Optional: the public IP baked into preview URLs (see RUNBOOK 7b). Also treated as an on-box
# address by the gate, because requests to it from the box hairpin back with it as the source.
# PREVIEW_IP=<instance-public-ip>

# Optional: per-assignee GitHub tokens so the draft PR is OPENED BY the assignee (not the box
# `gh` account) — used by both the pipeline and the chat UI's full-mode turns. Referenced by name
# from config.assigneeGhTokenEnv. Each token needs classic `repo` scope (fine-grained: Pull
# requests + Contents, read & write) on BOTH agentweb AND customer-portal. Leave a line unset to
# open that person's PRs as the box account — commits are still attributed to the assignee regardless.
# GH_TOKEN_MVARMA=ghp_xxxxxxxxxxxxxxxxxxxx
# GH_TOKEN_ASETH=ghp_xxxxxxxxxxxxxxxxxxxx
