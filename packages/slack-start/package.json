{
  "name": "@agentweb/slack-start",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable 'Get started in Slack' onboarding wizard (ENG-2782). One Preact core; script-tag auto-binding build and a React adapter.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./react": "./dist/react.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:embed": "node scripts/build.mjs --check-embed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:size && npm run check:embed && npm run test:e2e"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.6",
    "vitest": "^3.2.7"
  }
}
