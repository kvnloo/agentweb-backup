[Unit]
Description=AgentWeb Agent Engine (task_monitor.py) - scheduled chat trigger + web-agent runner
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=agent-engine-alert@%n.service

[Service]
Type=simple
User=agentengine
Group=agentengine
WorkingDirectory=/opt/agent-engine/agentweb/agent-engine
Environment=AGENT_ENGINE_ENV=production
Environment=AWS_REGION=us-west-2
Environment=BACKEND_URL=https://api.agentweb.pro
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/agent-engine/miniconda/envs/agent-engine/bin/python task_monitor.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
StandardOutput=append:/opt/agent-engine/agentweb/agent-engine/log/systemd_task_monitor.log
StandardError=append:/opt/agent-engine/agentweb/agent-engine/log/systemd_task_monitor.log

[Install]
WantedBy=multi-user.target
