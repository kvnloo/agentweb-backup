[Unit]
Description=Alert oncall that %i failed

[Service]
# Runs as agentengine (not root — avoids privilege escalation if this unit
# is ever triggered maliciously) but executes a script/interpreter/venv
# living under /opt/agent-engine-alert, which is root-owned and
# read/execute-only for agentengine (see deploy/RUNBOOK.md). This is
# deliberately NOT the agentengine-writable checkout — the thing that
# reports agent-engine's failure must not be modifiable by agent-engine
# itself if it's ever compromised.
Type=oneshot
User=agentengine
Group=agentengine
WorkingDirectory=/opt/agent-engine-alert
ExecStart=/opt/agent-engine-alert/venv/bin/python /opt/agent-engine-alert/alert_oncall.py %i
