# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: AWS Credentials (if using AWS Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region

# Optional: OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration
# Comma-separated list of LLMs to try in order
# Format for each LLM: <platform>-><provider>-><model>
# Valid combinations:
# - aws->anthropic->claude-3-5-sonnet-20241022-v2:0
# - azure->openai->gpt-4o
# - deepseek->deepseek->deepseek-reasoner
# - openai->openai->gpt-4o
# - openai->openai->gpt-4
# - openai->openai->gpt-3.5-turbo
LIST_FULL_LLM_NAMES=azure->openai->gpt-4o,aws->anthropic->anthropic.claude-3-5-sonnet-20241022-v2:0,openai->openai->gpt-4o

# Deep Research LLM Configuration
# Comma-separated list of LLMs to try in order specifically for deep research tasks
# Format for each LLM: <platform>-><provider>-><model>
# Valid combinations are the same as LIST_FULL_LLM_NAMES
DEEP_RESEARCH_LLM_NAMES=azure->openai->o1-mini,azure->openai->gpt-4o 

# Azure image generation (ENG-410)
# Required for the Azure image models (gpt-image-1, FLUX.1-Kontext-pro).
# Both must be set. An unset value fails loudly with a named error instead of
# falling back to a hardcoded endpoint (which previously pointed at a departed
# employee's personal Azure account).
# Base URL of the AgentWeb-owned Azure AI Services resource; trailing slashes are stripped.
AZURE_IMAGE_ENDPOINT=https://your-imagegen-resource.services.ai.azure.com
# API key for that SAME resource. Deliberately separate from AZURE_OPENAI_API_KEY2:
# the chat and image resources are different, so reusing the chat key would
# authenticate the image endpoint against the wrong resource.
AZURE_IMAGE_API_KEY=your_azure_image_api_key_here
