# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: AWS Credentials (if using AWS Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region

# Optional: OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o  # Options: gpt-4o, gpt-4, gpt-3.5-turbo

# LLM Configuration
# Options for LLM_Deployment_Platform: aws, azure, deepseek, openai
# Options for LLM_Provider: anthropic, openai, deepseek
LLM_Deployment_Platform=aws
LLM_Provider=anthropic 