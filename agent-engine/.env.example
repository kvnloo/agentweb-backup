# NOTE: In production these API keys/credentials are fetched from GCP Secret
# Manager (see secrets_manager.py) via the VM's own service account (ADC),
# not from this file. They're still required here for local development —
# set them below and they'll be used automatically (env var always takes
# precedence over Secret Manager).

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AWS Credentials (DynamoDB/S3/Bedrock access). Required for local dev.
# In production these come from the "agentengine-prod-aws-credentials"
# secret in GCP Secret Manager (a rotated, non-Rui-linked IAM user's key —
# there is no GCP<->AWS workload identity federation for this VM).
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
# Some boto3 clients (e.g. web_agent.py's S3 client) fall back to the
# default credential chain's region, which reads AWS_DEFAULT_REGION, not
# AWS_REGION. Keep both set to the same value.
AWS_DEFAULT_REGION=your_aws_region

# Scheduled chat processing (see README.md "Scheduled Chat Processing")
BACKEND_URL=http://localhost:3001
SCHEDULED_CHATS_SERVICE_SECRET=your_shared_secret_here

# Optional: OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration
# Comma-separated list of LLMs to try in order
# Format for each LLM: <platform>-><provider>-><model>
# Valid combinations:
# - aws->anthropic->claude-3-5-sonnet-20241022-v2:0
# - azure->openai->gpt-4o
# - deepseek->deepseek->deepseek-reasoner
# - openai->openai->gpt-4o
# - openai->openai->gpt-4
# - openai->openai->gpt-3.5-turbo
LIST_FULL_LLM_NAMES=azure->openai->gpt-4o,aws->anthropic->anthropic.claude-3-5-sonnet-20241022-v2:0,openai->openai->gpt-4o

# Deep Research LLM Configuration
# Comma-separated list of LLMs to try in order specifically for deep research tasks
# Format for each LLM: <platform>-><provider>-><model>
# Valid combinations are the same as LIST_FULL_LLM_NAMES
DEEP_RESEARCH_LLM_NAMES=azure->openai->o1-mini,azure->openai->gpt-4o 