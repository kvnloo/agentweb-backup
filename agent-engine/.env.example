# NOTE: In production these API keys/credentials are fetched from GCP Secret
# Manager (see secrets_manager.py) via the VM's own service account (ADC),
# not from this file. They're still required here for local development —
# set them below and they'll be used automatically (env var always takes
# precedence over Secret Manager).

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AWS Credentials (DynamoDB/S3/Bedrock access). Required for local dev.
# In production these come from the "agentengine-prod-aws-credentials"
# secret in GCP Secret Manager (a rotated, non-Rui-linked IAM user's key —
# there is no GCP<->AWS workload identity federation for this VM).
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region

# Scheduled chat processing (see README.md "Scheduled Chat Processing")
BACKEND_URL=http://localhost:3001
SCHEDULED_CHATS_SERVICE_SECRET=your_shared_secret_here

# Optional: OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration
# Comma-separated list of LLMs to try in order
# Format for each LLM: <platform>-><provider>-><model>
# Valid combinations:
# - aws->anthropic->claude-3-5-sonnet-20241022-v2:0
# - azure->openai->gpt-4o
# - deepseek->deepseek->deepseek-reasoner
# - openai->openai->gpt-4o
# - openai->openai->gpt-4
# - openai->openai->gpt-3.5-turbo
LIST_FULL_LLM_NAMES=azure->openai->gpt-4o,aws->anthropic->anthropic.claude-3-5-sonnet-20241022-v2:0,openai->openai->gpt-4o

# Deep Research LLM Configuration
# Comma-separated list of LLMs to try in order specifically for deep research tasks
# Format for each LLM: <platform>-><provider>-><model>
# Valid combinations are the same as LIST_FULL_LLM_NAMES
DEEP_RESEARCH_LLM_NAMES=azure->openai->o1-mini,azure->openai->gpt-4o

# Azure image generation (ENG-410)
# Required for the Azure image models (gpt-image-1, FLUX.1-Kontext-pro).
# Both must be set. An unset value fails loudly with a named error instead of
# falling back to a hardcoded endpoint (which previously pointed at a departed
# employee's personal Azure account).
# Base URL of the AgentWeb-owned Azure AI Services resource; trailing slashes are stripped.
AZURE_IMAGE_ENDPOINT=https://your-imagegen-resource.services.ai.azure.com
# API key for that SAME resource. Deliberately separate from AZURE_OPENAI_API_KEY2:
# the chat and image resources are different, so reusing the chat key would
# authenticate the image endpoint against the wrong resource.
AZURE_IMAGE_API_KEY=your_azure_image_api_key_here

# JWT signing/verification (shared-password encryption, share links)
JWT_SECRET=your_jwt_secret_here

# SMTP (used for oncall task-failure alerts and other transactional email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
FROM_EMAIL=your_from_email_here
SITE_DOMAIN=http://localhost:3000
# Real oncall recipient(s), comma-separated. NEVER a personal address.
ONCALL_EMAIL_LIST=oncall@agentweb.pro

# GitHub API key (used for reading/writing files in a specific repo — see task_utils.py)
GITHUB_API_KEY=your_github_api_key_here

# Google Programmable Search (web search tool)
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Video/image generation providers
RUNWAY_API_KEY=your_runway_api_key_here
REELMIND_API_KEY=your_reelmind_api_key_here
GOOGLE_VEO_API_KEY=your_google_veo_api_key_here
OPENAI_IMAGE_API_KEY=your_openai_image_api_key_here
