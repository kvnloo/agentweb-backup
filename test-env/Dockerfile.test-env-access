FROM node:20-alpine

WORKDIR /app

COPY test-env-access/package.json test-env-access/package-lock.json ./
RUN npm ci --omit=dev

COPY test-env-access/server.js ./
COPY test-env-access/public ./public

# allowlist.json will be mounted as a volume so it persists across rebuilds
EXPOSE 5175
CMD ["node", "server.js"]
