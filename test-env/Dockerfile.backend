FROM node:20-slim

# Install Chromium for puppeteer-core
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

# Install dependencies (cached layer)
COPY backend/package.json backend/package-lock.json ./
RUN npm ci

# Install Playwright's bundled Chrome so the Playwright MCP server (npx
# @playwright/mcp) can run browser_navigate / browser_click etc. The MCP
# process spawns its own Chrome instance via Playwright's launcher — it
# does NOT use the apt-installed chromium above (puppeteer-core uses that
# one; Playwright is a separate library with its own browser cache at
# ~/.cache/ms-playwright). Without this, every browser_navigate fails
# with `Run "npx playwright install chrome"` and Emma's onboarding
# brand-build wastes its budget on retries before falling back to
# search_web. ~300MB extra image size, acceptable for the test env.
RUN npx -y playwright install chrome --with-deps && rm -rf /var/lib/apt/lists/*

# Copy source and build
COPY backend/tsconfig.json ./
COPY backend/src ./src
COPY backend/docs ./docs
RUN NODE_OPTIONS=--max-old-space-size=4096 npm run build

# Copy non-TS assets to dist (templates, scripts, etc.)
RUN cp -r src/templates dist/templates 2>/dev/null || true

# Copy user-data script (needed by devEnvService to launch EC2 instances)
COPY test-env/user-data-dev-auto.sh ./dist/user-data-dev-auto.sh

EXPOSE 3001
CMD ["node", "dist/server.js"]
